---
type TechKey = "nextjs" | "astro" | "tailwind" | "strapi";

interface Props {
  tech: TechKey;
}

const { tech } = Astro.props as Props;

const TECH_LABEL: Record<TechKey, string> = {
  nextjs: "Next.js",
  astro: "Astro",
  tailwind: "TailwindCSS",
  strapi: "Strapi",
};

const TECH_CLASS: Record<TechKey, string> = {
  nextjs: "text-tech-nextjs border-tech-nextjs bg-tech-nextjs/25",
  astro: "text-tech-astro border-tech-astro bg-tech-astro/30",
  tailwind: "text-tech-tailwind border-tech-tailwind bg-tech-tailwind/30",
  strapi: "text-tech-strapi border-tech-strapi bg-tech-strapi/30",
};
---

<span
  class={`text-sm rounded-full font-bold border-2 w-fit px-2 pb-0.5 ${TECH_CLASS[tech]}`}
>
  {TECH_LABEL[tech]}
</span>
